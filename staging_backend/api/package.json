{
  "name": "@macrotech/approval-api",
  "private": true,
  "version": "0.3.1-desktop-alpha.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import=tsx src/*.test.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "express": "5.2.1",
    "firebase-admin": "14.3.0",
    "googleapis": "^178.1.1",
    "helmet": "8.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
